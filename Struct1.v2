#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX_PRODUTOS 50

// =====================================================
// 1. ESTRUTURA DO PRODUTO
// =====================================================

typedef struct {
    int codigo;
    char nome[50];
    float preco;
} Produto;


// =====================================================
// 2. BUSCAR PRODUTO PELO CÓDIGO
// =====================================================

int buscarProdutoPorCodigo(Produto produtos[], int total, int codigo) {
    int i;

    for (i = 0; i < total; i++) {
        if (produtos[i].codigo == codigo) {
            return i; // Retorna a posição onde encontrou
        }
    }

    return -1; // -1 significa que não encontrou
}


// =====================================================
// 3. CADASTRAR PRODUTO
// =====================================================

void cadastrarProduto(Produto produtos[], int *total) {

    int codigo;
    int entradaValida;

    system("cls");

    if (*total >= MAX_PRODUTOS) {
        printf("\n[ERRO] O estoque esta cheio!\n\n");
        system("pause");
        return;
    }

    printf("========================================\n");
    printf("          CADASTRO DE PRODUTO\n");
    printf("========================================\n\n");


    // -------------------------------------
    // VALIDAÇÃO DO CÓDIGO
    // -------------------------------------

    do {

        printf("Digite o codigo do produto: ");

        entradaValida = scanf("%d", &codigo);

        fflush(stdin);

        if (entradaValida != 1) {

            printf("\n[ERRO] Digite apenas numeros inteiros.\n\n");

        } else if (codigo <= 0) {

            printf("\n[ERRO] O codigo deve ser maior que zero.\n\n");

        } else if (
            buscarProdutoPorCodigo(produtos, *total, codigo) != -1
        ) {

            printf("\n[ERRO] Esse codigo ja esta cadastrado.\n\n");

        }

    } while (
        entradaValida != 1 ||
        codigo <= 0 ||
        buscarProdutoPorCodigo(produtos, *total, codigo) != -1
    );


    produtos[*total].codigo = codigo;


    // -------------------------------------
    // VALIDAÇÃO DO NOME
    // -------------------------------------

    do {

        printf("Digite o nome do produto: ");

        fgets(
            produtos[*total].nome,
            sizeof(produtos[*total].nome),
            stdin
        );

        produtos[*total].nome[
            strcspn(produtos[*total].nome, "\n")
        ] = '\0';


        if (strlen(produtos[*total].nome) == 0) {
            printf("\n[ERRO] O nome nao pode ficar vazio.\n\n");
        }

    } while (strlen(produtos[*total].nome) == 0);


    // -------------------------------------
    // VALIDAÇÃO DO PREÇO
    // -------------------------------------

    do {

        printf("Digite o preco do produto: R$ ");

        entradaValida = scanf(
            "%f",
            &produtos[*total].preco
        );

        fflush(stdin);


        if (entradaValida != 1) {

            printf("\n[ERRO] Digite um valor numerico.\n\n");

        } else if (produtos[*total].preco <= 0) {

            printf("\n[ERRO] O preco deve ser maior que zero.\n\n");

        }

    } while (
        entradaValida != 1 ||
        produtos[*total].preco <= 0
    );


    (*total)++;

    printf("\n>> Produto cadastrado com sucesso!\n\n");

    system("pause");
}


// =====================================================
// 4. LISTAR PRODUTOS
// =====================================================

void listarProdutos(Produto produtos[], int total) {

    int i;

    system("cls");

    printf("========================================\n");
    printf("       PRODUTOS CADASTRADOS (%d)\n", total);
    printf("========================================\n\n");


    if (total == 0) {

        printf("Nenhum produto cadastrado ainda.\n\n");

    } else {

        for (i = 0; i < total; i++) {

            printf("----------------------------------------\n");

            printf("Produto #%d\n", i + 1);

            printf(
                "Codigo : %d\n",
                produtos[i].codigo
            );

            printf(
                "Nome   : %s\n",
                produtos[i].nome
            );

            printf(
                "Preco  : R$ %.2f\n",
                produtos[i].preco
            );
        }

        printf("----------------------------------------\n\n");
    }


    system("pause");
}


// =====================================================
// 5. REMOVER PRODUTO
// =====================================================

void removerProduto(Produto produtos[], int *total) {

    int codigo;
    int posicao;
    int entradaValida;
    int i;

    system("cls");

    printf("========================================\n");
    printf("           REMOVER PRODUTO\n");
    printf("========================================\n\n");


    // Verifica se existem produtos
    if (*total == 0) {

        printf("Nenhum produto cadastrado.\n\n");

        system("pause");

        return;
    }


    // Valida o código digitado
    do {

        printf("Digite o codigo do produto: ");

        entradaValida = scanf("%d", &codigo);

        fflush(stdin);


        if (entradaValida != 1) {

            printf(
                "\n[ERRO] Digite apenas numeros inteiros.\n\n"
            );

        }

    } while (entradaValida != 1);


    // Procura o produto
    posicao = buscarProdutoPorCodigo(
        produtos,
        *total,
        codigo
    );


    // Produto não encontrado
    if (posicao == -1) {

        printf("\n[ERRO] Produto nao encontrado!\n\n");

        system("pause");

        return;
    }


    // Mostra qual produto será removido
    printf("\nProduto encontrado:\n\n");

    printf(
        "Codigo: %d\n",
        produtos[posicao].codigo
    );

    printf(
        "Nome: %s\n",
        produtos[posicao].nome
    );

    printf(
        "Preco: R$ %.2f\n\n",
        produtos[posicao].preco
    );


    // -------------------------------------
    // REMOÇÃO DO VETOR
    // -------------------------------------

    for (i = posicao; i < *total - 1; i++) {

        produtos[i] = produtos[i + 1];

    }


    (*total)--;


    printf(">> Produto removido com sucesso!\n\n");

    system("pause");
}


// =====================================================
// 6. MAIN
// =====================================================

int main() {

    Produto estoque[MAX_PRODUTOS];

    int totalProdutos = 0;
    int opcao;


    do {

        system("cls");

        printf("=============================\n");
        printf("     SISTEMA DE PRODUTOS\n");
        printf("=============================\n");

        printf("1. Cadastrar Produto\n");
        printf("2. Listar Produtos\n");
        printf("3. Remover Produto\n");
        printf("0. Sair\n");

        printf("=============================\n");

        printf("Escolha uma opcao: ");


        if (scanf("%d", &opcao) != 1) {

            opcao = -1;

        }

        fflush(stdin);


        switch (opcao) {

            case 1:

                cadastrarProduto(
                    estoque,
                    &totalProdutos
                );

                break;


            case 2:

                listarProdutos(
                    estoque,
                    totalProdutos
                );

                break;


            case 3:

                removerProduto(
                    estoque,
                    &totalProdutos
                );

                break;


            case 0:

                system("cls");

                printf(
                    "\nSaindo do sistema... Ate logo!\n\n"
                );

                break;


            default:

                printf(
                    "\nOpcao invalida! Tente novamente.\n\n"
                );

                system("pause");
        }


    } while (opcao != 0);


    return 0;
}
