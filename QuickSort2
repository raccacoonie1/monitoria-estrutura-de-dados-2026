#include <stdio.h>

// Função auxiliar para trocar dois elementos de posição na memória
void trocar(int *a, int *b) {
    int temp = *a;
    *a = *b;
    *b = temp;
}

// Função de Partição (Esquema de Lomuto)
int particionar(int arr[], int inicio, int fim) {
    int pivo = arr[fim];   // Escolhe o último elemento como pivô
    int i = (inicio - 1);  // Contador/Índice do menor elemento
    int j;                 // Variável declarada fora do for

    for (j = inicio; j < fim; j++) {
        // Se o elemento atual for menor ou igual ao pivô
        if (arr[j] <= pivo) {
            i++;
            trocar(&arr[i], &arr[j]);
        }
    }
    // Coloca o pivô na sua posição correta
    trocar(&arr[i + 1], &arr[fim]);
    return (i + 1); // Retorna o índice do pivô
}

// Função Principal Recursiva
void quickSort(int arr[], int inicio, int fim) {
    if (inicio < fim) {
        // pivo_idx é o índice onde o pivô já está ordenado
        int pivo_idx = particionar(arr, inicio, fim);

        // Ordena recursivamente as sub-listas
        quickSort(arr, inicio, pivo_idx - 1);
        quickSort(arr, pivo_idx + 1, fim);
    }
}

// Função auxiliar para imprimir o vetor na tela
void imprimirVetor(int arr[], int tamanho) {
    int i;
    for (i = 0; i < tamanho; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");
}

int main() {
    int arr[] = {10, 7, 8, 9, 1, 5};
    int n = sizeof(arr) / sizeof(arr[0]);

    printf("Vetor original: ");
    imprimirVetor(arr, n);

    quickSort(arr, 0, n - 1);

    printf("Vetor ordenado:  ");
    imprimirVetor(arr, n);

    return 0;
}
