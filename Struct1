#include <stdio.h> // printf e scanf
#include <stdlib.h> // system("cls") e system("pause")
#include <string.h> 

#define MAX_PRODUTOS 50

// 1. Definição da Estrutura (struct)
// Funciona como o "molde" ou "ficha" do produto
typedef struct {
    int codigo;
    char nome[50];
    float preco;
} Produto;

// 2. Função para Cadastrar um Produto
void cadastrarProduto(Produto produtos[], int *total) {
    system("cls"); // Limpa a tela no Windows
    
    if (*total >= MAX_PRODUTOS) {
        printf("\n[ERRO] O estoque esta cheio! Nao e possivel cadastrar mais produtos.\n\n");
        system("pause");
        return;
    }

    printf("========================================\n");
    printf("         CADASTRO DE PRODUTO %d          \n", *total + 1);
    printf("========================================\n\n");
    
    printf("Digite o codigo do produto: ");
    scanf("%d", &produtos[*total].codigo);
    fflush(stdin); // Limpa o buffer do teclado no Windows

    printf("Digite o nome do produto: ");
    fgets(produtos[*total].nome, sizeof(produtos[*total].nome), stdin);
    // Remove a quebra de linha do final da string lida pelo fgets
    produtos[*total].nome[strcspn(produtos[*total].nome, "\n")] = '\0';

    printf("Digite o preco do produto: R$ ");
    scanf("%f", &produtos[*total].preco);
    fflush(stdin); // Limpa o buffer do teclado no Windows

    (*total)++; // Incrementa a quantidade de produtos cadastrados
    printf("\n>> Produto cadastrado com sucesso!\n\n");
    
    system("pause");
}

// 3. Função para Listar os Produtos Cadastrados
void listarProdutos(Produto produtos[], int total) {
    int i;
    system("cls"); // Limpa a tela no Windows

    printf("========================================\n");
    printf("    LISTA DE PRODUTOS CADASTRADOS (%d)   \n", total);
    printf("========================================\n\n");

    if (total == 0) {
        printf("Nenhum produto cadastrado ainda.\n\n");
    } else {
        for (i = 0; i < total; i++) {
            printf("----------------------------------------\n");
            printf("Produto #%d\n", i + 1);
            printf("Codigo : %d\n", produtos[i].codigo);
            printf("Nome   : %s\n", produtos[i].nome);
            printf("Preco  : R$ %.2f\n", produtos[i].preco);
        }
        printf("----------------------------------------\n\n");
    }

    system("pause");
}

// 4. Função Principal (Menu do Sistema)
int main() {
    Produto estoque[MAX_PRODUTOS]; // Vetor de structs
    int totalProdutos = 0;         // Contador de produtos cadastrados
    int opcao;

    do {
        system("cls"); // Limpa a tela no Windows antes de desenhar o menu

        printf("=============================\n");
        printf("    SISTEMA DE PRODUTOS     \n");
        printf("=============================\n");
        printf("1. Cadastrar Produto\n");
        printf("2. Listar Produtos\n");
        printf("0. Sair\n");
        printf("=============================\n");
        printf("Escolha uma opcao: ");
        
        if (scanf("%d", &opcao) != 1) {
            opcao = -1; // Trata entrada caso o usuário digite uma letra
        }
        fflush(stdin);

        switch (opcao) {
            case 1:
                cadastrarProduto(estoque, &totalProdutos);
                break;
            case 2:
                listarProdutos(estoque, totalProdutos);
                break;
            case 0:
                system("cls");
                printf("\nSaindo do sistema... Ate logo!\n\n");
                break;
            default:
                printf("\nOpcao invalida! Tente novamente.\n\n");
                system("pause");
        }

    } while (opcao != 0);

    return 0;
}
