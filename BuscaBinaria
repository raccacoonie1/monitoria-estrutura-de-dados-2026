#include <stdio.h>

int buscaBinaria(int vetor[], int tamanho, int valor) {
    int inicio = 0;
    int fim = tamanho - 1;

    while (inicio <= fim) {
        int meio = (inicio + fim) / 2;

        if (vetor[meio] == valor) {
            return meio;
        }

        if (valor < vetor[meio]) {
            fim = meio - 1;
        } else {
            inicio = meio + 1;
        }
    }

    return -1;
}

int main() {
    int vetor[] = {10, 20, 30, 40, 50, 60, 70};
    int tamanho = 7;
    int valor = 20;

    int resultado = buscaBinaria(vetor, tamanho, valor);

    if (resultado != -1) {
        printf("Valor encontrado na posicao %d\n", resultado);
    } else {
        printf("Valor nao encontrado.\n");
    }

    return 0;
}
